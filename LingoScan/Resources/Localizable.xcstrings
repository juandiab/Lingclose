    "settings.range.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa en la curva, el sombreado de picos y el tiempo en rango. Solo orienta la lectura; no es un objetivo médico ni un dispositivo médico. \"Sugerir rango\" propone las líneas a partir de tus lecturas de los últimos 14 días y tú decides si usarlas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used in the curve, the spike shading and time in range. It only guides reading; it is not a medical target nor a medical device. “Suggest range” proposes the lines from your readings of the last 14 days and you decide whether to use them."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada na curva, no sombreado dos picos e no tempo na faixa. Serve apenas para orientar a leitura; não é uma meta médica nem um dispositivo médico. “Sugerir faixa” propõe as linhas a partir das suas leituras dos últimos 14 dias e você decide se quer usá-las."
          }
        }
      }
    },
