    "today.insights.meals.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subida respecto a la media de los 15 minutos previos; vuelta cuando la glucosa regresa a 10 mg/dL de esa media. La puntuación (0–100) baja con subidas mayores y vueltas más lentas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rise relative to the mean of the previous 15 minutes; back when glucose returns to within 10 mg/dL of that mean. The score (0–100) drops with larger rises and slower returns."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subida em relação à média dos 15 minutos anteriores; retorno quando a glicose volta a até 10 mg/dL dessa média. A pontuação (0–100) diminui com subidas maiores e retornos mais lentos."
          }
        }
      }
    },
