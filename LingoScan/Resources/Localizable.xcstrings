        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Astra precisa da identidade original instalada ou incluída na cópia criptografada. Uma sessão preparada ainda não permite recuperar um sensor ativo."
          }
        }
      }
