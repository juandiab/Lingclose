    "range.suggest.explanation.statistics" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea baja es el percentil 5 y la alta el percentil 95 de tus %lld lecturas válidas de los últimos %lld días (%@ días con datos), redondeados a múltiplos de 5. El 90 por ciento de tus lecturas quedó entre ambas. Son líneas para leer la curva, no objetivos clínicos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The low line is the 5th percentile and the high line the 95th percentile of your %lld valid readings from the last %lld days (%@ days with data), rounded to multiples of 5. 90 percent of your readings fell between them. They are lines for reading the curve, not clinical targets."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linha inferior é o percentil 5 e a superior o percentil 95 das suas %lld leituras válidas dos últimos %lld dias (%@ dias com dados), arredondados para múltiplos de 5. 90 por cento das suas leituras ficaram entre as duas. São linhas para ler a curva, não metas clínicas."
          }
        }
      }
    },
