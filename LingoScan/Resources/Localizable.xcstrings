    "coaching.mealOrder.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para la próxima comida"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For your next meal"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para a próxima refeição"
          }
        }
      }
    },
    "coaching.mealOrder.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar por verdura o proteína y dejar los carbohidratos al final suele dar un pico más suave."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting with vegetables or protein and leaving carbs for last usually gives a gentler peak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começar por verduras ou proteína e deixar os carboidratos para o fim costuma dar um pico mais suave."
          }
        }
      }
    },
    "coaching.noteContext.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota el contexto"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note the context"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote o contexto"
          }
        }
      }
    },
    "coaching.noteContext.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estrés, poco sueño o café? Anótalo para ver el patrón."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress, little sleep or coffee? Note it down to spot the pattern."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estresse, pouco sono ou café? Anote para enxergar o padrão."
          }
        }
      }
    },
    "coaching.moveLight.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimiento suave"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle movement"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimento leve"
          }
        }
      }
    },
    "coaching.moveLight.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos minutos de movimiento suave, como subir escaleras o caminar, suelen ayudar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few minutes of gentle movement, like taking the stairs or walking, usually helps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns minutos de movimento leve, como subir escadas ou caminhar, costumam ajudar."
          }
        }
      }
    },
    "coaching.alreadyFalling.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya va bajando"
