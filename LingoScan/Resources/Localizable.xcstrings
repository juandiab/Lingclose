      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La curva ya baja: espera y vuelve a mirar en 30 min."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The curve is already falling: wait and look again in 30 min."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A curva já está caindo: espere e olhe de novo em 30 min."
          }
        }
      }
    },
    "coaching.risingWait.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera y mira"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait and look"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere e observe"
          }
        }
      }
    },
    "coaching.risingWait.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin síntomas, lo normal es esperar: vuelve a mirar la curva en 30 min."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without symptoms, waiting is usually fine: check the curve again in 30 min."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem sintomas, o normal é esperar: olhe a curva de novo em 30 min."
          }
        }
      }
    },
    "coaching.highPersisting.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se repite"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it keeps happening"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se voltar a acontecer"
          }
        }
      }
    },
    "coaching.highPersisting.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ves valores altos a menudo sin motivo claro, coméntalo con un profesional de la salud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you often see high values with no clear reason, talk to a health professional."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você vê valores altos com frequência sem motivo claro, converse com um profissional de saúde."
          }
        }
      }
    },
    "coaching.lowSymptoms.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes síntomas"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have symptoms"
