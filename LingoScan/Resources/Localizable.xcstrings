        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tiver sintomas"
          }
        }
      }
    },
    "coaching.lowSymptoms.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con mareo o temblor, toma algo con carbohidratos y vuelve a mirar en 15 min."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you feel dizzy or shaky, have something with carbs and look again in 15 min."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com tontura ou tremor, consuma algo com carboidratos e olhe de novo em 15 min."
          }
        }
      }
    },
    "coaching.lowCompression.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin síntomas, espera"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No symptoms? Wait"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem sintomas, espere"
          }
        }
      }
    },
    "coaching.lowCompression.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede ser compresión del sensor al dormir sobre él: espera la siguiente lectura."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may be sensor compression from sleeping on it: wait for the next reading."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ser compressão do sensor por dormir sobre ele: espere a próxima leitura."
          }
        }
      }
    },
