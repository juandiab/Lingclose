        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en el Llavero de este iPhone, protegida por el código y Face ID, y no se sube a iCloud. Anótala también fuera del teléfono: sin ella no hay recuperación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica guardada no Chaveiro deste iPhone, protegida pelo código e pelo Face ID, e nunca é enviada ao iCloud. Anote-a também fora do telefone: sem ela não há recuperação."
