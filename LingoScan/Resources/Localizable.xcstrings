      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminar 10–15 min ayuda a suavizar el pico."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walking for 10–15 min helps smooth out the peak."
          }
