      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas son informativas y pueden retrasarse o no llegar (Bluetooth, batería, ajustes de iOS). LingoScan es un producto de bienestar, no un dispositivo médico; no tomes decisiones de salud solo con ellas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts are informational and may be delayed or not arrive (Bluetooth, battery, iOS settings). LingoScan is a wellness product, not a medical device; do not make health decisions based on them alone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os alertas são informativos e podem atrasar ou não chegar (Bluetooth, bateria, ajustes do iOS). O LingoScan é um produto de bem-estar, não um dispositivo médico; não tome decisões de saúde apenas com base neles."
          }
        }
      }
    },
