          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sugerencia no es consejo médico ni sustituye a un profesional de la salud. Las líneas solo ayudan a leer la curva; LingoScan no es un dispositivo médico. Nada cambia hasta que pulses \"Usar rango\"."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This suggestion is not medical advice and does not replace a health professional. The lines only help you read the curve; LingoScan is not a medical device. Nothing changes until you tap “Use range”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sugestão não é aconselhamento médico nem substitui um profissional de saúde. As linhas só ajudam a ler a curva; o LingoScan não é um dispositivo médico. Nada muda até você tocar em “Usar faixa”."
          }
