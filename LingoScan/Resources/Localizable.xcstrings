    "alerts.timing.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio rápido compara la media de los 5 primeros y los 5 últimos minutos de una ventana de 15. Mientras una condición se mantiene, el aviso se repite tras el silencio elegido; \"sin datos\" se repite como mucho cada hora."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast change compares the average of the first and last 5 minutes of a 15-minute window. While a condition lasts, the alert repeats after the chosen interval; “no data” repeats at most once an hour."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudança rápida compara a média dos 5 primeiros e dos 5 últimos minutos de uma janela de 15. Enquanto a condição persiste, o alerta se repete após o intervalo escolhido; “sem dados” se repete no máximo a cada hora."
          }
        }
      }
    },
