        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua y evita más azúcar ahora."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drink water and avoid more sugar for now."
          }
